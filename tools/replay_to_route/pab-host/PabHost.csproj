<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Poke-A-Byte's mapper engine (PokeAByte.Domain) driven one read at a time from stdin, for
    replay_to_route. The Poke-A-Byte sources are not part of this repository (AGPL): build.ps1
    snapshots the committed tree of a Poke-A-Byte checkout into ../.vendor/PokeAByte first.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pab-host</AssemblyName>
    <RootNamespace>PabHost</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <PokeAByteSrc Condition="'$(PokeAByteSrc)' == ''">$(MSBuildThisFileDirectory)..\.vendor\PokeAByte\src</PokeAByteSrc>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(PokeAByteSrc)\PokeAByte.Domain\PokeAByte.Domain.csproj" />
  </ItemGroup>

</Project>
